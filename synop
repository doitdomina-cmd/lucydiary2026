                            el.replaceWith(...el.childNodes);
                        }
                    });
                    editor.querySelectorAll('[style*="font-size"]').forEach(el => {
                        el.style.fontSize = '';
                        if (!el.getAttribute('style') || !el.getAttribute('style').trim()) el.removeAttribute('style');
                    });
                });
                (board.data || []).forEach(row => {
                    (row.cards || []).forEach(card => {
                        card.cardFontSize = value;
                        if (card.content) {
                            const tmp = document.createElement('div');
                            tmp.innerHTML = card.content;
                            tmp.querySelectorAll('font[size]').forEach(el => {
                                el.removeAttribute('size');
                                if (!el.getAttribute('style') && !el.getAttribute('color') && !el.getAttribute('face')) el.replaceWith(...el.childNodes);
                            });
                            tmp.querySelectorAll('[style*="font-size"]').forEach(el => {
                                el.style.fontSize = '';
                                if (!el.getAttribute('style').trim()) el.removeAttribute('style');
                            });
                            card.content = tmp.innerHTML;
                        }
                    });
                });
                // 집필 모드 창에 폰트 크기 변경 전달
                try { require('electron').ipcRenderer.send('writing-font-changed', { fontSize: value }); } catch(e) {}
                window.triggerSave();
                return;
            }
            // 폰트 글자체: 현재 보드 전체 카드 일괄 변경
            if (command === 'fontName') {
                const board = window.getCurrentBoard();
                if (!board) return;
                board.globalFontFamily = value;
                document.querySelectorAll('.rich-editor[id^="editor-"]').forEach(editor => {
                    editor.style.fontFamily = value;
                    editor.querySelectorAll('font[face]').forEach(el => {
                        el.removeAttribute('face');
                        if (!el.getAttribute('style') && !el.getAttribute('color') && !el.getAttribute('size')) el.replaceWith(...el.childNodes);
                    });
                    editor.querySelectorAll('[style*="font-family"]').forEach(el => {
                        el.style.fontFamily = '';
                        if (!el.getAttribute('style') || !el.getAttribute('style').trim()) el.removeAttribute('style');
                    });
                });
                (board.data || []).forEach(row => {
                    (row.cards || []).forEach(card => {
                        if (card.content) {
                            const tmp = document.createElement('div');
                            tmp.innerHTML = card.content;
                            tmp.querySelectorAll('font[face]').forEach(el => {
                                el.removeAttribute('face');
                                if (!el.getAttribute('style') && !el.getAttribute('color') && !el.getAttribute('size')) el.replaceWith(...el.childNodes);
                            });
                            tmp.querySelectorAll('[style*="font-family"]').forEach(el => {
                                el.style.fontFamily = '';
                                if (!el.getAttribute('style').trim()) el.removeAttribute('style');
                            });
                            card.content = tmp.innerHTML;
                        }
                    });
                });
                // 집필 모드 창에 폰트 변경 전달
                try { require('electron').ipcRenderer.send('writing-font-changed', { fontFamily: value }); } catch(e) {}
                window.triggerSave();
                return;
            }
            // formatBlock은 반드시 활성 에디터에만 적용
            if (command === 'formatBlock') {
                const editor = window.activeCardId ? document.getElementById(`editor-${window.activeCardId}`) : null;
                if (!editor) return;
                editor.focus();
                document.execCommand(command, false, value);
                return;
            }
            document.execCommand(command, false, value);
            if(window.activeCardId) {
                const editor = document.getElementById(`editor-${window.activeCardId}`);
                if(editor) editor.focus();
            }
        };

