            const resultsEl = document.getElementById('search-results');
            if (!query || query.length < 1) {
                resultsEl.innerHTML = '<span class="p-2 block text-xs text-gray-400">검색어를 입력하세요.</span>';
                return;
            }
            const q = query.toLowerCase();
            const results = [];

            window.workspaces.forEach(board => {
                (board.data || []).forEach((row, rIdx) => {
                    (row.cards || []).forEach((card, cIdx) => {
                        const titleMatch = (card.title || '').toLowerCase().includes(q);
                        const locMatch = (card.location || '').toLowerCase().includes(q);
                        const contentText = card.content ? card.content.replace(/<[^>]+>/g, '') : '';
                        const contentMatch = contentText.toLowerCase().includes(q);
                        if (titleMatch || locMatch || contentMatch) {
                            results.push({ board, row, card, rIdx, cIdx });
                        }
                    });
                });
            });

            if (results.length === 0) {
                resultsEl.innerHTML = '<span class="p-2 block text-xs text-gray-400">검색 결과가 없습니다.</span>';
                return;
            }

            resultsEl.innerHTML = results.map(r => `
