            if (command === 'fontSizeExact') {
                const board = window.getCurrentBoard();
                if (!board) return;
                board.globalFontSize = value;
                document.querySelectorAll('.rich-editor[id^="editor-"]').forEach(editor => {
                    editor.style.fontSize = value;
                    editor.querySelectorAll('font[size]').forEach(el => {
                        el.removeAttribute('size');
