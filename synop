<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>에피소드 기획 보드</title>
    <!-- Google Fonts (실제 로딩) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nanum+Gothic:wght@400;700;800&family=Nanum+Myeongjo:wght@400;700;800&family=KoPub+Batang:wght@300;500&display=swap" rel="stylesheet">
    <!-- Pretendard -->
    <link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" />
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- html2canvas for Image Export -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <style>
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        
        [contenteditable]:focus, input:focus, select:focus, textarea:focus { outline: none; box-shadow: none; }
        
        /* Drag and Drop 시각적 피드백 */
        .dragging { opacity: 0.5; border: 2px dashed #3b82f6 !important; }
        .drag-over { border-top: 4px solid #3b82f6 !important; }
        
        /* 보드 목록 Drag and Drop 피드백 */
        .board-dragging { opacity: 0.4; }
        .board-drag-over { border-top: 2px solid #3b82f6 !important; padding-top: 2px !important; }
        .folder-drag-over { background-color: rgba(59, 130, 246, 0.05) !important; outline: 1px dashed #3b82f6 !important; border-radius: 0.25rem; }
        
        /* 카드 Hover 시 툴 노출 */
        .card-wrapper .card-tools { display: none; }
        .card-wrapper:hover .card-tools { display: flex; }

        /* 서식 적용을 위한 기본 에디터 스타일 */
        .rich-editor { min-height: 80px; font-size: 10.5pt; line-height: 1.6; }
        .rich-editor blockquote { border-left: 3px solid #ccc; padding-left: 8px; color: #666; margin: 4px 0; }

        /* 빈 에디터 플레이스홀더 처리 */
        .empty-editor:before { content: attr(data-placeholder); color: #9ca3af; pointer-events: none; display: block; }

        /* 테마 시스템 CSS (채도를 낮춘 Muted 톤) */
        body[data-theme="green"] .theme-panel { background-color: #f4f6f4 !important; border-color: #e3e8e4 !important; }
        body[data-theme="green"] .theme-canvas { background-color: #eef1ef !important; }
        body[data-theme="pink"] .theme-panel { background-color: #fdf8f9 !important; border-color: #eedce0 !important; }
        body[data-theme="pink"] .theme-canvas { background-color: #f7f0f2 !important; }

        /* 메모 탭 버튼 스타일 트위크 */
        .memo-tab-btn { transition: all 0.2s; }
        .memo-tab-active { background-color: #eff6ff; border-color: #93c5fd; color: #1d4ed8; font-weight: 700; }

        /* 활성 카드 강조 (더 명확하게) */
        .card-wrapper.active-card {
            box-shadow: 0 0 0 2.5px #3b82f6, 0 4px 16px rgba(59,130,246,0.18) !important;
            z-index: 10;
        }

        /* 검색 하이라이트 */
        .search-highlight {
            background: #fef08a;
            border-radius: 2px;
        }

        /* 카드 복사 버튼 */
        .card-copy-btn {
            transition: all 0.15s;
        }

        /* 메모 탭 편집 모드 */
        .tab-edit-input {
            background: white;
            border: 1px solid #93c5fd;
            border-radius: 4px;
            padding: 2px 6px;
            font-size: 10px;
            width: 80px;
            outline: none;
        }

        /* 트랙 색상 칩 */
        .track-color-chip {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            display: inline-block;
            cursor: pointer;
            border: 1px solid rgba(0,0,0,0.1);
            flex-shrink: 0;
        }

        /* 카드 체크리스트 */
        .checklist-item {
            display: flex;
            align-items: center;
            gap: 4px;
            font-size: 11px;
            color: #4b5563;
            padding: 1px 0;
        }
        .checklist-item input[type="checkbox"] {
            cursor: pointer;
            accent-color: #3b82f6;
        }
        .checklist-item .check-done { text-decoration: line-through; color: #9ca3af; }

        /* 검색 패널 */
        #search-panel {
            transition: all 0.2s ease;
        }

        /* 카드 삭제 확인 토스트 */
        #delete-toast {
            transition: all 0.2s ease;
        }

        /* 툴바 버튼 활성 상태 표시 */
        .toolbar-btn-active {
            background: #eff6ff !important;
            color: #2563eb !important;
        }

        /* Undo/Redo 버튼 비활성 */
        .undo-btn:disabled, .redo-btn:disabled {
            opacity: 0.35;
            cursor: not-allowed;
        }

        /* Row header 색상 */
        .row-color-bg-red { background-color: #fee2e2 !important; }
        .row-color-bg-orange { background-color: #ffedd5 !important; }
        .row-color-bg-yellow { background-color: #fef9c3 !important; }
        .row-color-bg-green { background-color: #dcfce7 !important; }
        .row-color-bg-blue { background-color: #dbeafe !important; }
        .row-color-bg-purple { background-color: #f3e8ff !important; }
        .row-color-bg-pink { background-color: #fce7f3 !important; }
        .row-color-bg-gray { background-color: #f3f4f6 !important; }

        /* 왼쪽 사이드바 애니메이션 */
        .sidebar-left {
            transition: width 0.25s ease, opacity 0.25s ease, padding 0.25s ease;
            overflow: hidden;
        }
        .sidebar-left.collapsed {
            width: 0 !important;
            opacity: 0;
            padding: 0;
            pointer-events: none;
        }

        /* 집필 모드 플로팅 보드 패널 */
        #writing-mode-panel {
            position: fixed;
            top: 40px;
            left: 50%;
            transform: translateX(-50%);
            width: 1700px;
            height: calc(100vh - 60px);
            background: #fcfcfc;
            border-radius: 12px;
            box-shadow: 0 16px 60px rgba(0,0,0,0.35);
            z-index: 8500;
            display: flex;
            flex-direction: column;
            border: 1px solid #334155;
            overflow: hidden;
            min-width: 400px;
            min-height: 300px;
            resize: both;
        }
        #writing-mode-panel.hidden { display: none !important; }
        #writing-mode-panel .wmp-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 7px 16px;
            background: #1e293b;
            border-radius: 12px 12px 0 0;
            cursor: default;
            user-select: none;
            flex-shrink: 0;
            gap: 8px;
            height: 44px;
        }
        #writing-mode-panel .wmp-board-area {
            flex: 1;
            overflow: auto;
            position: relative;
            background: #fcfcfc;
            cursor: default;
        }
        #writing-mode-panel .wmp-board-area.panning {
            cursor: grabbing !important;
        }
        /* 집필 모드일 때 뒤 화면 완전히 숨김 - 배경 검정으로 덮기 */
        body.writing-mode-active {
            background: #1a1a2e !important;
        }
        body.writing-mode-active > *:not(#writing-mode-panel):not(#save-indicator):not(#delete-toast) {
            display: none !important;
        }

        /* 구 집필 모드 위젯 (대체됨) */
        #writing-mode-widget {
            position: fixed;
            top: 60px;
            right: 20px;
            width: 420px;
            min-height: 300px;
            max-height: 80vh;
            background: white;
            border-radius: 12px;
            box-shadow: 0 8px 40px rgba(0,0,0,0.22);
            z-index: 9000;
            display: flex;
            flex-direction: column;
            border: 1px solid #e5e7eb;
            resize: both;
            overflow: hidden;
        }
        #writing-mode-widget.hidden { display: none !important; }
        #writing-mode-widget .wm-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 12px;
            background: #f8fafc;
            border-bottom: 1px solid #e5e7eb;
            border-radius: 12px 12px 0 0;
            cursor: move;
            user-select: none;
            flex-shrink: 0;
        }
        #writing-mode-widget .wm-editor {
            flex: 1;
            padding: 16px;
            overflow-y: auto;
            outline: none;
            line-height: 1.8;
            min-height: 200px;
        }
        #writing-mode-widget .wm-footer {
            padding: 6px 12px;
            border-top: 1px solid #e5e7eb;
            background: #f8fafc;
            border-radius: 0 0 12px 12px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }
    </style>
</head>
<body data-theme="default" class="flex h-screen w-full bg-gray-50 font-sans text-sm text-gray-800 overflow-hidden transition-colors duration-300" style="font-family: 'Pretendard', sans-serif;">

    <!-- 로컬 저장 상태 인디케이터 -->
    <div id="save-indicator" class="fixed top-3 right-4 text-xs font-bold px-3 py-1.5 rounded-full shadow-sm bg-white border border-gray-200 z-50 transition-opacity duration-300 opacity-0 pointer-events-none flex items-center">
    </div>

    <!-- 카드 삭제 확인 토스트 (Undo 지원) -->
    <div id="delete-toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 bg-gray-800 text-white text-xs font-bold px-4 py-2.5 rounded-full shadow-xl z-[9999] hidden flex items-center gap-3">
        <span id="delete-toast-msg">카드가 삭제됩니다.</span>
        <button id="delete-undo-btn" class="bg-blue-500 hover:bg-blue-600 text-white px-3 py-1 rounded-full text-[11px] transition-colors">되돌리기</button>
    </div>

    <!-- 전체 검색 패널 -->
    <div id="search-panel" class="fixed top-14 left-1/2 -translate-x-1/2 bg-white border border-gray-200 shadow-2xl rounded-xl z-[100] w-[480px] hidden">
        <div class="p-3 flex items-center gap-2 border-b border-gray-100">
            <i data-lucide="search" class="w-4 h-4 text-gray-400 shrink-0"></i>
            <input id="search-input" type="text" placeholder="제목, 내용, 장소 검색..." class="flex-1 text-sm outline-none text-gray-800 bg-transparent" oninput="window.doSearch(this.value)" onkeydown="if(event.key==='Escape') window.closeSearch()">
            <button onclick="window.closeSearch()" class="text-gray-400 hover:text-gray-600 p-1 rounded">
                <i data-lucide="x" class="w-3.5 h-3.5"></i>
            </button>
        </div>
        <div id="search-results" class="max-h-80 overflow-y-auto p-2 text-xs text-gray-500">
            <span class="p-2 block">검색어를 입력하세요.</span>
        </div>
    </div>

    <!-- Left Sidebar Toggle Button (always visible) -->
    <button id="left-sidebar-toggle" onclick="window.toggleLeftSidebar()" 
            class="fixed left-0 top-1/2 -translate-y-1/2 z-30 bg-white border border-gray-200 shadow-md rounded-r-lg w-5 h-12 flex items-center justify-center text-gray-400 hover:text-blue-600 hover:bg-blue-50 transition-all duration-200"
            title="왼쪽 패널 접기/펼치기" style="display:none;">
        <i data-lucide="chevron-left" id="left-toggle-icon" class="w-3.5 h-3.5"></i>
    </button>

    <!-- 집필 모드 플로팅 보드 패널 -->
    <div id="writing-mode-panel" class="hidden">
        <div class="wmp-header" id="wmp-drag-handle">
            <div class="flex items-center gap-3">
                <i data-lucide="pen-line" class="w-4 h-4 text-indigo-300"></i>
                <span class="text-sm font-bold text-white tracking-wide">집필 모드</span>
                <span id="wmp-board-name" class="text-xs text-slate-400 font-normal"></span>
            </div>
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-2">
                    <i data-lucide="blend" class="w-3.5 h-3.5 text-slate-400"></i>
                    <span class="text-[11px] text-slate-400">투명도</span>
                    <input type="range" min="15" max="100" value="100" id="wmp-opacity-slider"
                           oninput="window.setWritingPanelOpacity(this.value)"
                           class="w-24 accent-indigo-400 cursor-pointer">
                    <span id="wmp-opacity-val" class="text-[11px] text-slate-300 w-8 text-right">100%</span>
                </div>
                <div class="w-px h-4 bg-slate-600"></div>
                <!-- 확대/축소 -->
                <div class="flex items-center gap-2">
                    <button onclick="window.wmpZoom(-0.1)" class="text-slate-300 hover:text-white p-1 rounded hover:bg-slate-600 transition-colors">
                        <i data-lucide="zoom-out" class="w-3.5 h-3.5"></i>
                    </button>
                    <span id="wmp-zoom-text" class="text-[11px] text-slate-300 w-9 text-center font-bold">100%</span>
                    <button onclick="window.wmpZoom(0.1)" class="text-slate-300 hover:text-white p-1 rounded hover:bg-slate-600 transition-colors">
                        <i data-lucide="zoom-in" class="w-3.5 h-3.5"></i>
                    </button>
                    <button onclick="window.wmpZoomReset()" class="text-[10px] text-slate-400 hover:text-white font-medium px-1.5 py-0.5 rounded hover:bg-slate-600 transition-colors">초기화</button>
                </div>
                <div class="w-px h-4 bg-slate-600"></div>
                <div class="flex items-center gap-2 text-slate-400 text-[11px]">
                    <i data-lucide="mouse-pointer-2" class="w-3.5 h-3.5"></i>
                    <span>우클릭 드래그 이동 · 우하단 모서리 크기 조절</span>
                </div>
                <div class="w-px h-4 bg-slate-600"></div>
                <button onclick="window.closeWritingMode()"
                        class="flex items-center gap-1.5 text-slate-300 hover:text-white bg-slate-700 hover:bg-red-600 px-3 py-1.5 rounded text-xs font-bold transition-colors">
                    <i data-lucide="x" class="w-3.5 h-3.5"></i> 집필 모드 종료
                </button>
            </div>
        </div>
        <!-- 보드 복사본이 렌더되는 영역 -->
        <div class="wmp-board-area" id="wmp-board-area">
            <div id="wmp-zoom-container" style="transform-origin: top left; transition: transform 0.15s;">
                <div class="p-8 pb-16">
                    <div id="wmp-doc-title" class="text-3xl font-bold text-gray-800 mb-6 px-1"></div>
                    <div id="wmp-board-container" class="flex flex-col border-t border-l border-gray-200 bg-white shadow-sm w-max min-w-full"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Left Sidebar -->

    <div class="theme-panel sidebar-left w-56 bg-white border-r border-gray-200 flex flex-col shrink-0 z-20 shadow-sm relative transition-colors duration-300" id="left-sidebar">
        <div class="p-4 font-bold text-lg border-b border-gray-100 flex items-center justify-between text-gray-800">
            <div class="flex items-center gap-2">
                <i data-lucide="book-open" class="w-5 h-5 text-gray-600"></i> 작업 공간
            </div>
            <button onclick="window.toggleLeftSidebar()" class="text-gray-400 hover:text-blue-600 p-1 rounded transition-colors" title="패널 접기">
                <i data-lucide="panel-left-close" class="w-4 h-4"></i>
            </button>
        </div>
        
        <div class="p-2 flex-1 overflow-y-auto border-b border-gray-100 custom-scrollbar flex flex-col relative">
            <div class="flex items-center justify-between p-2 hover:bg-black/5 rounded text-gray-600 group cursor-pointer mb-3" onclick="window.createNewBoard()">
                <span class="flex items-center gap-2 text-xs font-semibold"><i data-lucide="layout" class="w-4 h-4"></i> 새 시놉시스 생성</span>
                <button class="text-gray-400 hover:text-blue-600 p-1 rounded hover:bg-black/5" title="새 보드 생성">
                    <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                </button>
            </div>
            
            <!-- 진행 중인 플롯 목록 -->
            <div class="flex flex-col flex-1 min-h-[45%] max-h-[60%]">
                <div class="pt-2 pb-2 px-2 text-[14px] font-extrabold text-gray-600 tracking-wide border-b border-gray-100 mb-2">진행 중 시놉시스</div>
                <div id="board-list-active" class="space-y-0.5 overflow-y-auto custom-scrollbar flex-1" ondragover="window.handleBoardDragOver(event)" ondrop="window.handleBoardDrop(event, null, 'active')">
                </div>
            </div>

            <!-- 완결 시놉시스 보관함 -->
            <div class="mt-2 pt-4 border-t border-gray-200 flex flex-col flex-1 min-h-[30%]">
                <div class="pb-2 px-2 text-[14px] font-extrabold text-gray-600 tracking-wide border-b border-gray-100 mb-2 cursor-pointer flex items-center justify-between hover:text-gray-800 transition-colors" 
                     onclick="window.toggleCompletedFolder()"
                     ondragover="window.handleBoardDragOverFolder(event)" 
                     ondrop="window.handleBoardDrop(event, null, 'completed')">
                    <span>완결 시놉시스 보관함</span>
                    <i data-lucide="chevron-down" id="completed-folder-icon" class="w-4 h-4 text-gray-400 transition-transform duration-300"></i>
                </div>
                <div id="board-list-completed" class="space-y-0.5 overflow-y-auto custom-scrollbar transition-all duration-300 hidden flex-1 mt-1" ondragover="window.handleBoardDragOverFolder(event)" ondragleave="window.handleBoardDragLeaveFolder(event)" ondrop="window.handleBoardDrop(event, null, 'completed')">
                </div>
            </div>
        </div>

        <!-- Data Management (Bottom) -->
        <div class="p-4 border-t border-gray-100 flex flex-col gap-3 text-[11px] text-gray-500 font-medium">
            <!-- Theme Selection -->
            <div class="mb-1 pb-3 border-b border-gray-100 border-dashed flex justify-between items-center">
                <span class="block text-[10px] font-bold text-gray-400 tracking-wider">테마 색상</span>
                <div class="flex gap-2">
                    <button onclick="window.setTheme('default')" class="w-4 h-4 rounded-full bg-gray-200 border border-gray-300 hover:scale-110 transition-transform shadow-sm" title="기본 (회색)"></button>
                    <button onclick="window.setTheme('green')" class="w-4 h-4 rounded-full bg-[#eef1ef] border border-[#e3e8e4] hover:scale-110 transition-transform shadow-sm" title="차분한 녹색"></button>
                    <button onclick="window.setTheme('pink')" class="w-4 h-4 rounded-full bg-[#f7f0f2] border border-[#eedce0] hover:scale-110 transition-transform shadow-sm" title="차분한 분홍"></button>
                </div>
            </div>
            
            <!-- Export Actions -->
            <div class="flex items-center gap-1.5">
                <button onclick="window.exportText()" class="flex-1 flex items-center justify-center gap-1 py-1.5 bg-gray-100 hover:bg-blue-50 text-gray-600 hover:text-blue-600 rounded font-bold transition-colors">
                    <i data-lucide="file-output" class="w-3.5 h-3.5"></i> 텍스트
                </button>
                <button onclick="window.exportImage()" class="flex-1 flex items-center justify-center gap-1 py-1.5 bg-gray-100 hover:bg-blue-50 text-gray-600 hover:text-blue-600 rounded font-bold transition-colors">
                    <i data-lucide="camera" class="w-3.5 h-3.5"></i> 이미지
                </button>
            </div>
            
            <!-- Data Management -->
            <div class="flex items-center justify-between pt-1 text-[10px]">
                <button onclick="window.exportData()" class="hover:text-gray-800 transition-colors" title="수동 파일 백업">백업</button>
                <span class="text-gray-300">|</span>
                <button onclick="document.getElementById('import-file').click()" class="hover:text-gray-800 transition-colors" title="수동 백업본 불러오기">불러오기</button>
                <span class="text-gray-300">|</span>
                <button onclick="window.triggerSave(true)" class="text-blue-600 hover:text-blue-800 font-bold transition-colors" title="G드라이브 강제 동기화">강제</button>
                <span class="text-gray-300">|</span>
                <button onclick="window.resetData()" class="text-gray-400 hover:text-red-500 transition-colors">초기화</button>
            </div>
            <input type="file" id="import-file" accept=".json" class="hidden" onchange="window.importData(event)">
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col min-w-0 bg-[#fcfcfc] relative">
        <!-- Top Toolbar -->
        <div class="theme-panel top-toolbar h-12 bg-white border-b border-gray-200 flex items-center justify-between px-4 shrink-0 z-10 shadow-sm transition-colors duration-300">
            <!-- Left: Text Formatting -->
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-2 text-gray-600 border-r border-gray-200/60 pr-4">
                    <select onchange="window.formatText('formatBlock', this.value)" class="bg-transparent cursor-pointer hover:text-gray-900 text-sm outline-none">
                        <option value="div">본문</option>
                        <option value="H1">제목 1</option>
                        <option value="H2">제목 2</option>
                        <option value="H3">제목 3</option>
                        <option value="BLOCKQUOTE">인용구</option>
                    </select>
                    <span class="text-gray-300">|</span>
                    <select id="font-select" onchange="window.formatText('fontName', this.value)" class="bg-transparent cursor-pointer hover:text-gray-900 text-sm w-24 outline-none">
                        <option value="Pretendard, sans-serif">Pretendard</option>
                        <option value="'KoPub Batang', serif">바탕체</option>
                        <option value="'Nanum Gothic', sans-serif">나눔고딕</option>
