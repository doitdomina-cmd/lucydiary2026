            if (!_deletedCardCache) return;
            clearTimeout(_deleteToastTimer);
            hideDeleteToast();
            const data = window.getCurrentBoard().data;
            const row = data.find(r => r.id === _deletedCardCache.rowId);
            if (row) {
                row.cards.splice(_deletedCardCache.cardIdx, 0, _deletedCardCache.card);
                renderAll();
                window.triggerSave();
