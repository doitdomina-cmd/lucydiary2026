        // 집필 모드 → 본 창 폰트 반영 전용. IPC를 다시 보내지 않아 무한 루프를 끊는다.
        window._applyFontNoIpc = (kind, value) => {
          try {
            const board = window.getCurrentBoard();
            if (!board) return;
            const isSize = (kind === 'fontSize');
            const attr   = isSize ? 'size' : 'face';
            const cssKey = isSize ? 'font-size' : 'font-family';
            const styleProp = isSize ? 'fontSize' : 'fontFamily';

            document.querySelectorAll('.rich-editor[id^="editor-"]').forEach(editor => {
                Array.from(editor.querySelectorAll(`font[${attr}]`)).forEach(el => {
                    el.removeAttribute(attr);
                    if (!el.getAttribute('style') && !el.getAttribute('color') &&
                        !el.getAttribute('size') && !el.getAttribute('face')) {
                        el.replaceWith(...Array.from(el.childNodes));
                    }
                });
                Array.from(editor.querySelectorAll(`[style*="${cssKey}"]`)).forEach(el => {
                    el.style[styleProp] = '';
                    const st = el.getAttribute('style');
                    if (!st || !st.trim()) el.removeAttribute('style');
                });
                editor.style[styleProp] = value;
            });

            (board.data || []).forEach(row => {
                (row.cards || []).forEach(card => {
                    if (isSize) card.cardFontSize = value;
                    if (!card.content) return;
                    const tmp = document.createElement('div');
                    tmp.innerHTML = card.content;
                    Array.from(tmp.querySelectorAll(`font[${attr}]`)).forEach(el => {
                        el.removeAttribute(attr);
                        if (!el.getAttribute('style') && !el.getAttribute('color') &&
                            !el.getAttribute('size') && !el.getAttribute('face')) {
                            el.replaceWith(...Array.from(el.childNodes));
                        }
                    });
                    Array.from(tmp.querySelectorAll(`[style*="${cssKey}"]`)).forEach(el => {
                        el.style[styleProp] = '';
                        const st = el.getAttribute('style');
                        if (!st || !st.trim()) el.removeAttribute('style');
                    });
                    card.content = tmp.innerHTML;
                });
            });
            window.triggerSave();
          } catch (err) {
            console.error('[_applyFontNoIpc]', kind, value, err);
          }
        };

