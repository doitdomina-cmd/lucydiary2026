        window.triggerSave = function(force = false) {
            showSaveIndicator('loading');
            if (saveTimeout) clearTimeout(saveTimeout);
            const delay = force ? 0 : 1000;
            
            saveTimeout = setTimeout(async () => {
                try {
                    const cleanDataStr = JSON.stringify(window.workspaces, null, 2);
                    let gDriveSuccess = false;
                    if (isNodeEnvironment) {
                        if (!fs.existsSync(TARGET_DIR)) {
                            try { fs.mkdirSync(TARGET_DIR, { recursive: true }); } catch(e) {}
                        }
                        if (fs.existsSync(TARGET_DIR)) {
                            await fs.promises.writeFile(targetFilePath, cleanDataStr, 'utf8');
                            gDriveSuccess = true;
                            showSaveIndicator('gdrive_success');
                        }
                    }
                    if (dbInitialized) {
                        await saveToLocalDB(JSON.parse(cleanDataStr));
                        if(!gDriveSuccess) showSaveIndicator('local_success');
                    }
                } catch (e) {
                    console.error("Save error", e);
                    showSaveIndicator('error');
                }
            }, delay);
