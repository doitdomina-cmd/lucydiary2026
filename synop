        window.duplicateCard = (cardId) => {
            pushHistory();
            const data = window.getCurrentBoard().data;
            for (let r of data) {
                const idx = r.cards.findIndex(c => c.id === cardId);
                if (idx !== -1) {
                    const original = r.cards[idx];
                    const copy = JSON.parse(JSON.stringify(original));
                    copy.id = generateId();
                    copy.title = (copy.title || '') + ' (복사)';
                    copy.checklist = (copy.checklist || []).map(item => ({ ...item, id: generateId() }));
