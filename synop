        function renderChecklist(card) {
            const container = document.getElementById('checklist-container');
            if (!card || !card.checklist || card.checklist.length === 0) {
                container.innerHTML = '<span class="text-[11px] text-gray-400">카드를 선택하면 체크리스트를 편집할 수 있어요.</span>';
                return;
            }
            container.innerHTML = card.checklist.map((item, idx) => `
                <div class="checklist-item" id="check-item-${item.id}">
                    <input type="checkbox" ${item.done ? 'checked' : ''} onchange="window.toggleCheckItem('${card.id}', '${item.id}', this.checked)">
                    <input type="text" value="${escapeHtml(item.text)}" placeholder="할 일 입력..." 
                           class="flex-1 bg-transparent border-none outline-none text-[11px] ${item.done ? 'line-through text-gray-400' : 'text-gray-700'}"
                           oninput="window.updateCheckItem('${card.id}', '${item.id}', this.value)"
                           onkeydown="if(event.key==='Enter'){window.addChecklistItem()}"
                           >
                    <button onclick="window.removeCheckItem('${card.id}', '${item.id}')" class="text-gray-300 hover:text-red-400 transition-colors">
                        <i data-lucide="x" class="w-3 h-3"></i>
