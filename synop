                if(!w.status) w.status = 'active'; 
                const isActive = w.id === window.currentWorkspaceId;
                const iconColor = isActive ? 'text-gray-700' : 'text-gray-400 group-hover:text-gray-500';
                const textStyle = isActive ? 'text-gray-800 font-bold' : 'text-gray-500';
                const bgStyle = isActive ? 'bg-gray-200' : 'hover:bg-black/5';
                const iconName = w.status === 'completed' ? 'book' : 'book-open';

                const boardHtml = `
                    <div onclick="window.switchBoard('${w.id}')"
                         draggable="true" 
                         ondragstart="window.handleBoardDragStart(event, '${w.id}')"
                         ondragover="window.handleBoardDragOver(event)"
                         ondrop="window.handleBoardDrop(event, '${w.id}', '${w.status}')"
                         class="group flex items-center justify-between p-2 rounded cursor-pointer transition-colors ${bgStyle} mb-0.5"
                         data-id="${w.id}">
                        <div class="flex items-center gap-2 overflow-hidden flex-1 pointer-events-none">
                            <i data-lucide="${iconName}" class="w-3.5 h-3.5 ${iconColor} shrink-0 transition-colors"></i>
                            <span class="truncate text-xs ${textStyle}">${escapeHtml(w.title) || '제목 없음'}</span>
                        </div>
                        <button onclick="window.deleteBoard('${w.id}', event)" class="opacity-0 group-hover:opacity-100 p-1 text-gray-400 hover:text-red-500 transition-opacity shrink-0 ml-1 cursor-pointer" title="보드 삭제">
                            <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                        </button>
                    </div>
                `;
                if (w.status === 'completed') listCompleted.insertAdjacentHTML('beforeend', boardHtml);
                else listActive.insertAdjacentHTML('beforeend', boardHtml);
            });
        }

        function renderBoard() {
            const board = window.getCurrentBoard();
            if (!board) return; 

            const currentWidth = board.cardWidth || 400;
            document.getElementById('doc-title').value = board.title || '';

            // 폰트 사이즈 드롭다운 동기화
            const fsSel = document.getElementById('font-size-select');
            if (fsSel && board.globalFontSize) {
                fsSel.value = board.globalFontSize;
            }
            // 폰트 글자체 드롭다운 동기화
            const ffSel = document.getElementById('font-select');
            if (ffSel && board.globalFontFamily) {
                ffSel.value = board.globalFontFamily;
            }
            
            // 메모 탭 렌더링
            renderMemoTabs(board);
            window.switchMemoTab(window.activeMemoTab);

            const container = document.getElementById('board-container');
            container.innerHTML = '';

            (board.data || []).forEach((row, index) => {
                const rowTotalWords = (row.cards || []).reduce((sum, card) => {
                    const val = card.estWords ? String(card.estWords).replace(/[^0-9]/g, '') : '0';
                    return sum + (parseInt(val) || 0);
                }, 0);

                const rowColorCls = getRowColorCls(row.color || 'gray');
                // 색상 칩 색상
                const chipColorMap = {
                    gray: '#e5e7eb', red: '#fca5a5', orange: '#fdba74', yellow: '#fde68a',
                    green: '#86efac', blue: '#93c5fd', purple: '#d8b4fe', pink: '#f9a8d4'
                };
                const chipColor = chipColorMap[row.color || 'gray'] || '#e5e7eb';

                let cardsHtml = (row.cards || []).map(card => {
                    const isActive = window.activeCardId === card.id;
                    const markersHtml = (card.markers || []).map(m => {
                        const colorClass = markerColors[m] || 'text-gray-500';
                        return `<i data-lucide="${m}" class="w-4 h-4 ${colorClass} drop-shadow-sm"></i>`;
                    }).join('');
                    const checkDone = (card.checklist || []).filter(i => i.done).length;
                    const checkTotal = (card.checklist || []).length;
                    const checkBadge = checkTotal > 0 ? `<span class="text-[9px] font-bold px-1.5 py-0.5 rounded-full ${checkDone === checkTotal ? 'bg-green-100 text-green-600' : 'bg-gray-100 text-gray-500'}">${checkDone}/${checkTotal}</span>` : '';
                    
                    return `
                        <div class="card-wrapper relative flex flex-col border-r border-b border-gray-200 aspect-[4/3] ${card.color || 'bg-white'} ${isActive ? 'active-card' : ''} transition-all duration-200 bg-opacity-90 shrink-0" 
                             style="width: ${currentWidth}px;"
                             data-card-id="${card.id}" data-row-id="${row.id}"
                             onclick="window.selectCard('${card.id}')"
                             ondragover="window.handleCardDragOver(event)"
                             ondragenter="window.handleCardDragEnter(event)"
                             ondragleave="window.handleCardDragLeave(event)"
                             ondrop="window.handleCardDrop(event, '${card.id}', '${row.id}')">
                            
                            <div class="card-tools absolute -top-3 -right-3 flex gap-1 z-20">
                                <button class="w-6 h-6 bg-white border border-gray-200 text-gray-400 rounded-full flex items-center justify-center shadow hover:text-blue-500 cursor-grab active:cursor-grabbing"
                                        draggable="true" 
                                        ondragstart="window.handleCardDragStart(event, '${card.id}', '${row.id}')" title="드래그하여 이동">
                                    <i data-lucide="grip-horizontal" class="w-3 h-3"></i>
                                </button>
                                <button onclick="window.duplicateCard('${card.id}'); event.stopPropagation();" class="w-6 h-6 bg-white border border-gray-200 text-gray-400 rounded-full flex items-center justify-center shadow hover:text-blue-500 transition-colors" title="카드 복사">
                                    <i data-lucide="copy" class="w-3 h-3"></i>
                                </button>
                                <button onclick="window.deleteCard('${card.id}'); event.stopPropagation();" class="w-6 h-6 bg-red-500 text-white rounded-full flex items-center justify-center shadow hover:bg-red-600 transition-colors" title="삭제">
                                    <i data-lucide="x" class="w-3 h-3"></i>
                                </button>
                            </div>

                            <div class="p-2 border-b border-gray-100 bg-white/60 relative min-h-[44px] flex flex-col justify-center">
                                <div class="flex items-center w-full gap-1.5">
                                    <div class="flex gap-1 items-center shrink-0" id="markers-${card.id}">${markersHtml}</div>
                                    <input type="text" value="${escapeHtml(card.title)}" oninput="window.updateCardTitle('${card.id}', this.value)" spellcheck="false" style="flex: 4;" class="min-w-0 text-[14px] text-gray-900 bg-transparent border-none outline-none font-bold py-1 px-1 placeholder-gray-400 hover:bg-black/5 focus:bg-white focus:ring-1 focus:ring-gray-200 rounded transition-all" placeholder="장면 제목">
                                    <input type="text" value="${escapeHtml(card.location)}" oninput="window.updateCardLocation('${card.id}', this.value)" spellcheck="false" style="flex: 2.5;" class="min-w-0 text-[13px] text-gray-700 bg-transparent border-none outline-none py-1 px-1 font-medium placeholder-gray-400 text-right hover:bg-black/5 focus:bg-white focus:ring-1 focus:ring-gray-200 rounded transition-all" placeholder="장소">
                                    <input type="text" value="${escapeHtml(card.estWords)}" oninput="window.updateCardEstWords('${card.id}', this.value)" spellcheck="false" style="flex: 1;" class="min-w-0 text-[13px] text-blue-600 bg-transparent border-none outline-none py-1 px-1 placeholder-gray-400 text-right hover:bg-blue-50 focus:bg-white focus:ring-1 focus:ring-blue-200 rounded transition-all" placeholder="글자수">
                                    ${checkBadge}
                                </div>
                            </div>
                            
                            <div class="flex-1 p-3 overflow-y-auto custom-scrollbar">
                                <div id="editor-${card.id}" contenteditable="true" spellcheck="false"
                                     oninput="window.updateCardContent('${card.id}', this.innerHTML)" 
                                     onfocus="window.selectCard('${card.id}')"
                                     class="rich-editor w-full h-full outline-none leading-relaxed text-gray-800" 
                                     style="font-size:${board.globalFontSize || card.cardFontSize || '10.5pt'};${board.globalFontFamily ? 'font-family:' + board.globalFontFamily + ';' : ''}"
                                     data-placeholder="">${card.content || ''}</div>
                            </div>
                        </div>
                    `;
                }).join('');

                cardsHtml += `
                    <div class="add-card-btn flex flex-col items-center justify-center border-r border-b border-gray-200 bg-gray-50/50 aspect-[4/3] hover:bg-blue-50 hover:text-blue-500 text-gray-300 cursor-pointer transition-colors group shrink-0"
                         style="width: ${currentWidth}px;"
                         onclick="window.addCardToRow('${row.id}')"
                         ondragover="window.handleCardDragOver(event)"
                         ondrop="window.handleCardDropToEmptyRow(event, '${row.id}')">
                        <i data-lucide="plus" class="w-8 h-8 group-hover:scale-110 transition-transform"></i>
                        <span class="text-xs mt-2 font-medium opacity-0 group-hover:opacity-100 transition-opacity">장면 추가</span>
                    </div>
                `;

                const rowHtml = `
                    <div class="flex flex-row w-full bg-white border-gray-200 group/row relative min-w-max">
                        <div class="w-24 shrink-0 border-r border-b border-gray-200 flex flex-col items-center justify-center p-2 ${rowColorCls} relative">
                            <div class="absolute top-1.5 left-2 flex items-center gap-1">
                                <span class="text-[10px] text-gray-400 font-bold">Track ${index + 1}</span>
                                <button onclick="window.cycleRowColor('${row.id}')" title="트랙 색상 변경" 
                                        style="background-color:${chipColor};"
                                        class="track-color-chip hover:scale-125 transition-transform"></button>
                            </div>
                            <textarea oninput="window.updateRowTitle('${row.id}', this.value)" spellcheck="false" class="w-full text-center outline-none bg-transparent text-gray-700 font-bold text-sm resize-none h-20 mt-4 leading-tight overflow-hidden" placeholder="행 이름">${escapeHtml(row.title)}</textarea>
                            <div id="row-total-${row.id}" class="text-[11px] text-gray-600 font-bold mt-1 bg-white/70 px-3 py-1 rounded-full text-center whitespace-nowrap shadow-none min-w-[64px] flex items-center justify-center" title="총 예상 글자 수">${rowTotalWords.toLocaleString()}자</div>
                        </div>
                        <div class="flex-1 flex flex-row">
                            ${cardsHtml}
                        </div>
                    </div>
                `;
                container.insertAdjacentHTML('beforeend', rowHtml);
            });

            if(document.getElementById('track-count')) {
                document.getElementById('track-count').textContent = board.data.length;
            }
            updateBoardTotalDOM();
            applyFilterDOM(); 
            
            document.querySelectorAll('[contenteditable]').forEach(el => {
                if(el.innerHTML.trim() === '' || el.innerHTML === '<br>') el.classList.add('empty-editor');
                el.addEventListener('input', function() {
                    if(this.innerHTML.trim() === '' || this.innerHTML === '<br>') this.classList.add('empty-editor');
                    else this.classList.remove('empty-editor');
                });
            });
        }

        function updateBoardTotalDOM() {
            const board = window.getCurrentBoard();
            if (!board) return;
            let total = 0;
            (board.data || []).forEach(row => {
                (row.cards || []).forEach(card => {
                    const val = card.estWords ? String(card.estWords).replace(/[^0-9]/g, '') : '0';
                    total += (parseInt(val) || 0);
                });
            });
            const topTotalSpan = document.getElementById('board-total-words');
            if (topTotalSpan) topTotalSpan.textContent = total.toLocaleString();
        }

        function updateRowTotalDOM(rowId) {
            const row = window.getCurrentBoard().data.find(r => r.id === rowId);
            if (row) {
                const total = (row.cards || []).reduce((sum, card) => {
                    const val = card.estWords ? String(card.estWords).replace(/[^0-9]/g, '') : '0';
                    return sum + (parseInt(val) || 0);
                }, 0);
                const totalSpan = document.getElementById(`row-total-${rowId}`);
                if (totalSpan) totalSpan.textContent = total.toLocaleString() + '자';
            }
        }

        function applyFilterDOM() {
            document.querySelectorAll('.card-wrapper').forEach(el => {
                if (!window.activeFilter) {
                    el.classList.remove('opacity-20', 'grayscale');
                } else {
                    const cardId = el.dataset.cardId;
                    const result = findCardAndRow(cardId);
                    if (result && (result.card.markers || []).includes(window.activeFilter)) {
                        el.classList.remove('opacity-20', 'grayscale');
                    } else {
                        el.classList.add('opacity-20', 'grayscale');
                    }
                }
            });
        }

        function renderPalette() {
            const palette = document.getElementById('palette-grid');
            palette.innerHTML = '';
            colors.forEach(color => {
                palette.insertAdjacentHTML('beforeend', `
                    <div class="flex items-center justify-center">
                        <button onclick="window.changeCardColor('${color.class}')" class="w-6 h-6 rounded border border-gray-200 shadow-sm hover:scale-110 transition-transform ${color.viewClass}"></button>
                    </div>
                `);
            });
        }

        function renderAll() {
            renderBoardList();
            renderBoard();
            const board = window.getCurrentBoard();
            const currentWidth = board ? (board.cardWidth || 400) : 400;
            const slider = document.getElementById('card-size-slider');
            const text = document.getElementById('card-size-text');
            if (slider && text) {
                slider.value = currentWidth;
                text.textContent = currentWidth + 'px';
            }
            window.toggleFilter(window.activeFilter); 
            updateUndoRedoUI();
            if(window.lucide) window.lucide.createIcons();
        }

        function initCanvasPanning() {
            const wrapper = document.getElementById('canvas-wrapper');
            wrapper.addEventListener('contextmenu', e => {
                if(e.target.tagName !== 'INPUT' && e.target.tagName !== 'TEXTAREA' && !e.target.hasAttribute('contenteditable')) {
                    e.preventDefault();
                }
            });
            wrapper.addEventListener('mousedown', e => {
                if (e.button === 2) { 
                    window.isPanning = true; wrapper.style.cursor = 'grabbing';
                    window.startX = e.pageX - wrapper.offsetLeft; window.startY = e.pageY - wrapper.offsetTop;
                    window.scrollLeft = wrapper.scrollLeft; window.scrollTop = wrapper.scrollTop;
                }
            });
            wrapper.addEventListener('mouseleave', () => { window.isPanning = false; wrapper.style.cursor = 'default'; });
            wrapper.addEventListener('mouseup', e => {
                if (e.button === 2) { window.isPanning = false; wrapper.style.cursor = 'default'; }
            });
            wrapper.addEventListener('mousemove', e => {
                if (!window.isPanning) return;
                e.preventDefault();
                const x = e.pageX - wrapper.offsetLeft; const y = e.pageY - wrapper.offsetTop;
                wrapper.scrollLeft = window.scrollLeft - (x - window.startX) * 1.5;
                wrapper.scrollTop = window.scrollTop - (y - window.startY) * 1.5;
            });
            
            // 팔레트 밖 클릭 시 닫기
            document.addEventListener('click', (e) => {
                const palette = document.getElementById('text-color-palette');
                const btn = document.getElementById('color-picker-btn');
                if (palette && !palette.classList.contains('hidden') && !palette.contains(e.target) && !btn.contains(e.target)) {
                    palette.classList.add('hidden');
                }
                // 검색 패널 외부 클릭 시 닫기
                const searchPanel = document.getElementById('search-panel');
                const searchInput = document.getElementById('search-input');
                if (searchPanel && !searchPanel.classList.contains('hidden') &&
                    !searchPanel.contains(e.target) && !e.target.closest('[onclick*="openSearch"]')) {
                    window.closeSearch();
                }
            });
            
            document.addEventListener('dragleave', (e) => {
                if(e.target.closest('.group')) e.target.closest('.group').classList.remove('board-drag-over');
            });

            // ========== 단축키 ==========
            document.addEventListener('keydown', (e) => {
                const tag = document.activeElement.tagName;
                const isEditing = ['INPUT', 'TEXTAREA'].includes(tag) || document.activeElement.hasAttribute('contenteditable');

                // Ctrl+Z: Undo
                if (e.ctrlKey && e.key === 'z' && !e.shiftKey && !isEditing) {
                    e.preventDefault();
                    window.undoAction();
                }
                // Ctrl+Y / Ctrl+Shift+Z: Redo
                if ((e.ctrlKey && e.key === 'y') || (e.ctrlKey && e.shiftKey && e.key === 'z')) {
                    if (!isEditing) { e.preventDefault(); window.redoAction(); }
                }
                // Ctrl+F: 검색
                if (e.ctrlKey && e.key === 'f') {
                    e.preventDefault();
                    window.openSearch();
                }
                // Escape: 검색 닫기
                if (e.key === 'Escape') {
                    window.closeSearch();
                }
            });
        }

        async function loadInitialData() {
            if (isNodeEnvironment && fs.existsSync(targetFilePath)) {
                try {
                    const fileData = await fs.promises.readFile(targetFilePath, 'utf8');
                    const parsedData = JSON.parse(fileData);
                    if (parsedData && parsedData.length > 0) {
                        console.log("G드라이브에서 데이터를 성공적으로 불러왔습니다.");
                        return parsedData;
                    }
                } catch(e) {
                    console.error("G드라이브 파일 읽기 실패:", e);
                }
            }
            console.log("로컬 DB에서 데이터를 불러옵니다.");
            return await loadFromLocalDB();
        }

        document.addEventListener('DOMContentLoaded', async () => {
            renderPalette();
            initCanvasPanning();
            initWritingModeWidget();

            // 집필 모드에서 폰트 변경 시 본 보드에도 동기화
            try {
                const { ipcRenderer } = require('electron');
                ipcRenderer.on('font-changed-from-writing', (e, { fontSize, fontFamily }) => {
                    const board = window.getCurrentBoard();
                    if (!board) return;
                    // 주의: 여기서 window.formatText()를 호출하면 그 안에서 다시
                    // ipcRenderer.send('writing-font-changed')가 실행되어 main.js가
                    // 또 이 이벤트를 돌려보내는 무한 루프가 발생한다(브라우저에선 require가
                    // 없어 send가 실패하므로 루프가 안 생기지만 Electron exe에선 멈춤).
                    // 따라서 IPC를 재전송하지 않는 _applyFontNoIpc로 직접 적용한다.
                    if (fontSize)   { board.globalFontSize   = fontSize;   window._applyFontNoIpc('fontSize', fontSize); }
                    if (fontFamily) { board.globalFontFamily = fontFamily; window._applyFontNoIpc('fontFamily', fontFamily); }
                    // 드롭다운 동기화
                    const fsSel = document.getElementById('font-size-select');
                    const ffSel = document.getElementById('font-select');
                    if (fsSel && fontSize)   fsSel.value = fontSize;
                    if (ffSel && fontFamily) ffSel.value = fontFamily;
                });
            } catch(e) {}
            
            try {
                await initLocalDB();
                const savedData = await loadInitialData();
                const lastId = await loadLastWorkspaceId();
                if (savedData && savedData.length > 0) {
                    _skipHistory = true;
                    window.workspaces = normalizeData(savedData);
                    // 마지막으로 열었던 보드가 있으면 복원, 없으면 첫 번째
                    const restored = lastId && window.workspaces.find(w => w.id === lastId);
                    window.currentWorkspaceId = restored ? lastId : window.workspaces[0].id;
                    const board = window.getCurrentBoard();
                    if (board && board.memoTabs) window.activeMemoTab = board.memoTabs[0].id;
                    _skipHistory = false;
                }
            } catch (err) {
                console.error("Data Load Error:", err);
            }
            
            renderAll();
        });

    </script>
</body>
</html>
