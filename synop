    <!-- Node.js + IndexedDB 하이브리드 로직 -->
    <script>
// --- Node.js File System 세팅 (Electron 전용) ---
let fs, pathModule, os;
let isNodeEnvironment = false;
let TARGET_DIR = '';
let targetFilePath = '';

try {
    fs = require('fs');
    pathModule = require('path');
    os = require('os');
    isNodeEnvironment = true;

    if (os.platform() === 'win32') {
        TARGET_DIR = 'G:\\내 드라이브\\백업\\시놉시스 파일';
    } else if (os.platform() === 'darwin') {
        TARGET_DIR = '/Users/lucy/Library/CloudStorage/GoogleDrive-doitdomina@gmail.com/내 드라이브/백업/시놉시스 파일';
    }

    targetFilePath = pathModule.join(TARGET_DIR, '시놉시스_자동백업_데이터.json');
} catch(e) {
    console.warn("Node.js API 연동 실패 (일반 브라우저 환경에서 실행됨)");
}

        // --- Utility ---
        const escapeHtml = (unsafe) => {
            if (unsafe == null) return '';
            return String(unsafe)
                 .replace(/&/g, "&amp;")
                 .replace(/</g, "&lt;")
                 .replace(/>/g, "&gt;")
                 .replace(/"/g, "&quot;")
                 .replace(/'/g, "&#039;");
        };

        const generateId = () => 'id_' + Date.now() + Math.random().toString(36).substr(2, 9);

        // --- IndexedDB ---
        const DB_NAME = 'PlotBoardLocalDB';
        const STORE_NAME = 'workspaces';
        let db = null;
        let dbInitialized = false;

        function initLocalDB() {
            return new Promise((resolve, reject) => {
                const request = indexedDB.open(DB_NAME, 1);
                request.onerror = (event) => reject(event.target.error);
                request.onsuccess = (event) => {
                    db = event.target.result;
                    dbInitialized = true;
                    resolve(db);
                };
                request.onupgradeneeded = (event) => {
                    const db = event.target.result;
                    if (!db.objectStoreNames.contains(STORE_NAME)) {
                        db.createObjectStore(STORE_NAME, { keyPath: 'id' });
                    }
                };
            });
        }

        function loadFromLocalDB() {
            return new Promise((resolve, reject) => {
                if (!db) return resolve(null);
                const transaction = db.transaction([STORE_NAME], 'readonly');
                const store = transaction.objectStore(STORE_NAME);
                const request = store.get('main_save');
                request.onsuccess = (event) => resolve(request.result ? request.result.data : null);
                request.onerror = () => resolve(null);
            });
        }

        function saveToLocalDB(dataToSave) {
            return new Promise((resolve, reject) => {
                if (!db) return resolve();
                const transaction = db.transaction([STORE_NAME], 'readwrite');
                const store = transaction.objectStore(STORE_NAME);
                const request = store.put({ id: 'main_save', data: dataToSave });
                request.onsuccess = () => {
                    // 마지막으로 열었던 보드 ID도 함께 저장
                    const t2 = db.transaction([STORE_NAME], 'readwrite');
                    const s2 = t2.objectStore(STORE_NAME);
                    s2.put({ id: 'last_workspace_id', data: window.currentWorkspaceId });
                    resolve();
                };
                request.onerror = (event) => reject(event.target.error);
            });
        }

        function loadLastWorkspaceId() {
            return new Promise((resolve) => {
                if (!db) return resolve(null);
                const transaction = db.transaction([STORE_NAME], 'readonly');
                const store = transaction.objectStore(STORE_NAME);
                const request = store.get('last_workspace_id');
                request.onsuccess = () => resolve(request.result ? request.result.data : null);
                request.onerror = () => resolve(null);
            });
        }

        // --- 데이터 정규화 (구버전 호환) ---
        const DEFAULT_MEMO_TABS = [
            { id: 'mainMale', label: '남자주인공' },
            { id: 'mainFemale', label: '여자주인공' },
            { id: 'subChar', label: '조연' },
            { id: 'background', label: '배경' },
            { id: 'synopsis', label: '시놉시스' },
            { id: 'keyDevice', label: '주요장치' },
            { id: 'general', label: '메모' },
        ];

        const memoTabPlaceholders = {
            mainMale: '남자주인공의 성격, 외모, 배경, 설정 등을 기록하세요.',
            mainFemale: '여자주인공의 성격, 외모, 배경, 설정 등을 기록하세요.',
            subChar: '중요 조연 및 주변 인물들의 관계와 설정을 기록하세요.',
            background: '작품의 핵심 세계관, 공간적/시간적 배경을 기록하세요.',
            synopsis: '전체 줄거리와 기승전결 뼈대를 요약 기록하세요.',
            keyDevice: '작품 내 중요한 복선, 키워드, 소품 등을 기록하세요.',
            general: '자유로운 아이디어나 추가 메모를 기록하세요.'
        };

        function normalizeData(data) {
            if (!Array.isArray(data)) return [];
            data.forEach(w => {
                if (!w.status) w.status = 'active';
                if (!w.cardWidth) w.cardWidth = 400;
                if (!w.globalFontSize) w.globalFontSize = '10.5pt';
                if (!w.globalFontFamily) w.globalFontFamily = '';
                if (!w.memos || typeof w.memos !== 'object') {
                    const oldMemo = (typeof w.memo === 'string') ? w.memo : '';
                    w.memos = { mainMale: '', mainFemale: '', subChar: '', background: '', synopsis: '', keyDevice: '', general: oldMemo };
                }
                // 메모 탭 커스터마이징 초기화
                if (!w.memoTabs) {
                    w.memoTabs = JSON.parse(JSON.stringify(DEFAULT_MEMO_TABS));
                }
                // 카드별 체크리스트 초기화
                (w.data || []).forEach(row => {
                    (row.cards || []).forEach(card => {
                        if (!card.checklist) card.checklist = [];
                        if (!card.rowColor) card.rowColor = 'gray';
                        if (!card.cardFontSize) card.cardFontSize = '';
                    });
                    if (!row.color) row.color = 'gray';
                });
            });
            return data;
        }

        // ========== Undo / Redo 시스템 ==========
        const MAX_HISTORY = 50;
        let undoStack = [];
        let redoStack = [];
        let _skipHistory = false;

        function pushHistory() {
            if (_skipHistory) return;
            const snapshot = JSON.stringify(window.workspaces);
            // 같은 상태면 스킵
            if (undoStack.length > 0 && undoStack[undoStack.length - 1] === snapshot) return;
            undoStack.push(snapshot);
            if (undoStack.length > MAX_HISTORY) undoStack.shift();
            redoStack = [];
            updateUndoRedoUI();
        }

        function updateUndoRedoUI() {
            const undoBtn = document.getElementById('undo-btn');
            const redoBtn = document.getElementById('redo-btn');
            if (undoBtn) undoBtn.disabled = undoStack.length === 0;
            if (redoBtn) redoBtn.disabled = redoStack.length === 0;
        }

        window.undoAction = () => {
            if (undoStack.length === 0) return;
            const current = JSON.stringify(window.workspaces);
            redoStack.push(current);
            const prev = undoStack.pop();
            _skipHistory = true;
            window.workspaces = normalizeData(JSON.parse(prev));
            // currentWorkspaceId 유효성 확인
            if (!window.workspaces.find(w => w.id === window.currentWorkspaceId)) {
                window.currentWorkspaceId = window.workspaces[0]?.id;
            }
            renderAll();
            window.triggerSave();
            _skipHistory = false;
            updateUndoRedoUI();
        };

        window.redoAction = () => {
            if (redoStack.length === 0) return;
            const current = JSON.stringify(window.workspaces);
            undoStack.push(current);
            const next = redoStack.pop();
            _skipHistory = true;
            window.workspaces = normalizeData(JSON.parse(next));
            if (!window.workspaces.find(w => w.id === window.currentWorkspaceId)) {
                window.currentWorkspaceId = window.workspaces[0]?.id;
            }
            renderAll();
            window.triggerSave();
            _skipHistory = false;
            updateUndoRedoUI();
