            );
            if (newLabels === null) return;
            const parts = newLabels.split(',').map(s => s.trim()).filter(Boolean).slice(0, 7);
            if (parts.length === 0) return;

            pushHistory();
            board.memoTabs = parts.map((label, i) => ({
                id: tabs[i] ? tabs[i].id : generateId(),
