        function showDeleteToast(cardData, rowId, cardIdx) {
            _deletedCardCache = { card: JSON.parse(JSON.stringify(cardData)), rowId, cardIdx };
            const toast = document.getElementById('delete-toast');
            const msg = document.getElementById('delete-toast-msg');
            msg.textContent = `"${cardData.title || '제목 없음'}" 카드가 삭제됩니다.`;
            toast.classList.remove('hidden');
            toast.classList.add('flex');

            if (_deleteToastTimer) clearTimeout(_deleteToastTimer);
            _deleteToastTimer = setTimeout(() => {
                hideDeleteToast();
                _deletedCardCache = null;
            }, 4000);
        }

        function hideDeleteToast() {
            const toast = document.getElementById('delete-toast');
            toast.classList.add('hidden');
            toast.classList.remove('flex');
        }

